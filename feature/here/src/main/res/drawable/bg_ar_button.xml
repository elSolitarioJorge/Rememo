<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 最外层：极宽、极淡的光晕 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <stroke android:width="8dp" android:color="#1AF5A623"/> <!-- 10%透明度 -->
        </shape>
    </item>
    <!-- 中层：稍窄、较亮的光晕 -->
    <item android:bottom="3dp" android:top="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <stroke android:width="4dp" android:color="#4DF5A623"/> <!-- 30%透明度 -->
        </shape>
    </item>
    <!-- 最内层：实体背景和实线边框 -->
    <item android:bottom="6dp" android:top="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#CC16192B"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#F5A623"/> <!-- 100%实体金边 -->
        </shape>
    </item>
</layer-list>