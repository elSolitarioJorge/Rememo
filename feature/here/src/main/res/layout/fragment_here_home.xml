<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D17">

    <com.amap.api.maps.TextureMapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_gradient_top_dark"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_gradient_bottom_dark"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/view_scan_line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/bg_scan_line"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/top_console"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="48dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_search_hud"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                app:tint="#64748B" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="monospace"
                android:hint="检索时空锚点..."
                android:singleLine="true"
                android:textColor="#E2E8F0"
                android:textColorHint="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_ar_lab"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_ar_button"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/view_ar_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ar_glow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_camera_fill"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="AR"
                    android:textColor="#F5A623"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hsv_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/top_console">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/FilterChipStyle"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip_active"
                android:text="全部时空"
                android:textColor="#F5A623" />

            <TextView
                style="@style/FilterChipStyle"
                android:layout_marginEnd="10dp"
                android:text="📻 旧物" />

            <TextView
                style="@style/FilterChipStyle"
                android:layout_marginEnd="10dp"
                android:text="🏘️ 老街区" />

            <TextView
                style="@style/FilterChipStyle"
                android:text="👥 故人" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layout_hud_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsv_filters">

        <TextView
            android:id="@+id/tv_hud_lat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:shadowColor="#80F5A623"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            android:text="LAT: 34.1528° N"
            android:textColor="#B3F5A623"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_hud_lng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:shadowColor="#80F5A623"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            android:text="LNG: 108.9421° E"
            android:textColor="#B3F5A623"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="2dp"
                android:layout_height="10dp"
                android:layout_marginEnd="6dp"
                android:background="#F5A623" />

            <TextView
                android:id="@+id/tv_hud_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxWidth="220dp"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:singleLine="true"
                android:text="LOC: 正在获取时空坐标..."
                android:textColor="#E2E8F0"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="SYS_ONLINE"
            android:textColor="#4DFFFFFF"
            android:textSize="8sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_my_location"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="110dp"
        android:background="@drawable/bg_location_btn_dark"
        android:contentDescription="定位"
        android:elevation="6dp"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_location_follow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/map_view"
        app:tint="#F5A623" />

</androidx.constraintlayout.widget.ConstraintLayout>

