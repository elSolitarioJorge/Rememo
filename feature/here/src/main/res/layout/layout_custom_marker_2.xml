<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_ar_glow" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_holo_pic"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerInParent="true"
            app:cardBackgroundColor="#CC16192B"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#F5A623"
            app:strokeWidth="1.5dp">

            <ImageView
                android:id="@+id/iv_marker_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tv_marker_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp"
                android:background="#CC000000"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:text="1 记忆"
                android:textColor="#F5A623"
                android:textSize="9sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

    <View
        android:id="@+id/view_holo_beam"
        android:layout_width="3dp"
        android:layout_height="24dp"
        android:layout_marginTop="-15dp"
        android:background="@drawable/bg_holo_beam" />

    <!-- 3. 地面发光坐标点 (带透视感) -->
    <View
        android:id="@+id/view_holo_dot"
        android:layout_width="20dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_holo_dot" />

</LinearLayout>