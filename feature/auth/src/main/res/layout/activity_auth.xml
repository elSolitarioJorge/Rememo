<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    android:background="@color/bg_slate">

    <ImageView
        android:id="@+id/iv_bg_layer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_sample"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_bg_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/shape_bg_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/iv_compass_ring"
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:background="@drawable/shape_dashed_ring"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintHorizontal_bias="-0.4" />

    <View
        android:id="@+id/v_particle_1"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/shape_particle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="100dp"
        android:layout_marginStart="40dp"/>

    <View
        android:id="@+id/v_particle_2"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/shape_particle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="50dp"
        android:layout_marginEnd="-20dp"/>

    <View
        android:id="@+id/v_floating_card"
        android:layout_width="100dp"
        android:layout_height="130dp"
        android:background="@drawable/shape_glass_panel"
        android:rotation="15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="100dp"
        android:layout_marginStart="-20dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="80dp"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/v_ping_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_btn_primary" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="@color/amber_500" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.2"
            android:text="拾忆"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.1"
            android:text="—  定格时空经纬  —"
            android:textColor="@color/white_alpha_80"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/fl_form_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp">

            <!-- ================= 登录面板 ================= -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_login_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_glass_panel"
                android:padding="24dp"
                tool:visibility="visible">

                <TextView
                    android:id="@+id/tv_tab_pwd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="密码登录"
                    android:textColor="@color/amber_400"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingBottom="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_tab_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="验证码登录"
                    android:textColor="@color/white_alpha_40"
                    android:textSize="14sp"
                    android:paddingBottom="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tv_tab_pwd" />

                <View
                    android:id="@+id/v_divider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/white_alpha_10"
                    app:layout_constraintTop_toBottomOf="@id/tv_tab_pwd"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/v_tab_indicator"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="@color/amber_400"
                    app:layout_constraintTop_toBottomOf="@id/tv_tab_pwd"
                    app:layout_constraintStart_toStartOf="@id/tv_tab_pwd"
                    app:layout_constraintEnd_toEndOf="@id/tv_tab_pwd" />

                <FrameLayout
                    android:id="@+id/fl_login_inputs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/v_tab_indicator">

                    <LinearLayout
                        android:id="@+id/ll_pwd_fields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@id/v_tab_indicator">

                        <EditText
                            android:id="@+id/et_login_account"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/selector_glass_input"
                            android:hint="请输入手机号码"
                            android:paddingHorizontal="16dp"
                            android:textColor="@android:color/white"
                            android:textColorHint="@color/white_alpha_30"
                            android:textCursorDrawable="@drawable/shape_cursor"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_login_pwd"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/selector_glass_input"
                            android:hint="请输入登录密码"
                            android:inputType="textPassword"
                            android:paddingHorizontal="16dp"
                            android:textColor="@android:color/white"
                            android:textColorHint="@color/white_alpha_30"
                            android:textCursorDrawable="@drawable/shape_cursor"
                            android:textSize="14sp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:paddingHorizontal="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="忘记密码？"
                                android:textColor="@color/white_alpha_40"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_switch_register"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="注册新账号 >"
                                android:textColor="@color/amber_400"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_code_fields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/v_tab_indicator">

                        <EditText
                            android:id="@+id/et_login_code_phone"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/selector_glass_input"
                            android:hint="请输入手机号码"
                            android:inputType="phone"
                            android:paddingHorizontal="16dp"
                            android:textColor="@android:color/white"
                            android:textColorHint="@color/white_alpha_30"
                            android:textCursorDrawable="@drawable/shape_cursor"
                            android:textSize="14sp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp">

                            <EditText
                                android:id="@+id/et_login_code"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/selector_glass_input"
                                android:hint="请输入短信验证码"
                                android:inputType="number"
                                android:paddingStart="16dp"
                                android:paddingEnd="100dp"
                                android:textColor="@android:color/white"
                                android:textColorHint="@color/white_alpha_30"
                                android:textCursorDrawable="@drawable/shape_cursor"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_get_code_login"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/shape_btn_code"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="获取验证码"
                                android:textColor="@color/white_alpha_80"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </LinearLayout>
                </FrameLayout>

                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/shape_btn_primary"
                    android:letterSpacing="0.1"
                    android:text="登 录"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/fl_login_inputs" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ================= 注册面板 ================= -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_register_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/shape_glass_panel"
                android:padding="24dp"
                android:visibility="gone"
                tool:alpha="1">

                <LinearLayout
                    android:id="@+id/ll_reg_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tv_back_login"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/shape_btn_code"
                        android:gravity="center"
                        android:text="←"
                        android:textSize="16dp"
                        android:textColor="@color/white_alpha_80"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="加入时空拾荒者"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_reg_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/ll_reg_header">

                    <EditText
                        android:id="@+id/et_reg_phone"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/selector_glass_input"
                        android:hint="请输入手机号码"
                        android:inputType="phone"
                        android:paddingHorizontal="16dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/white_alpha_30"
                        android:textCursorDrawable="@drawable/shape_cursor"
                        android:textSize="14sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp">

                            <EditText
                                android:id="@+id/et_reg_code"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/selector_glass_input"
                                android:hint="请输入短信验证码"
                                android:inputType="number"
                                android:paddingStart="16dp"
                                android:paddingEnd="100dp"
                                android:textColor="@android:color/white"
                                android:textColorHint="@color/white_alpha_30"
                                android:textCursorDrawable="@drawable/shape_cursor"
                                android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_get_code_reg"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/shape_btn_code"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:text="获取验证码"
                            android:textColor="@color/white_alpha_80"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <EditText
                        android:id="@+id/et_reg_pwd"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/selector_glass_input"
                        android:hint="设置账号密码"
                        android:inputType="textPassword"
                        android:paddingHorizontal="16dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/white_alpha_30"
                        android:textCursorDrawable="@drawable/shape_cursor"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/cb_agreement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:buttonTint="@color/amber_500"
                        android:text="注册即同意《拾忆条款》与《隐私政策》"
                        android:textColor="@color/white_alpha_40"
                        android:textSize="10sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_register"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/shape_btn_primary"
                    android:letterSpacing="0.2"
                    android:text="启 程"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/ll_reg_fields" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 底部快捷登录区 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:letterSpacing="0.1"
            android:text="- 快捷登录 -"
            android:textColor="@color/white_alpha_30"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_btn_code"
                android:padding="10dp"
                android:src="@drawable/ic_weixin"
                android:scaleType="centerCrop"
                app:tint="#4ADE80" />

            <Space
                android:layout_width="20dp"
                android:layout_height="wrap_content" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_btn_code"
                android:padding="10dp"
                android:src="@drawable/ic_qq"
                android:scaleType="centerCrop"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>