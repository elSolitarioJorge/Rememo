<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 获取焦点时的状态 -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/black_alpha_50" />
            <stroke android:width="1.5dp" android:color="@color/amber_alpha_60" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- 默认未获焦状态 -->
    <item>
        <shape>
            <solid android:color="@color/black_alpha_30" />
            <stroke android:width="1dp" android:color="@color/white_alpha_08" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>