<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:layout_marginEnd="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_image_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="#F59E0B"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/iv_add_more"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#16192B"
            android:padding="16dp"
            android:src="@drawable/ic_add_pic"
            app:tint="#F5A623"
            android:visibility="visible" />

        <View
            android:id="@+id/view_selected_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:visibility="visible" />

    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/iv_delete"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:background="@drawable/bg_delete_icon"
        android:padding="3dp"
        android:src="@drawable/ic_cancel"
        android:visibility="gone"
        app:tint="#FFFFFF" />

</FrameLayout>