<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/itemLocationCardWidth"
    android:layout_height="@dimen/itemLocationCardHeight"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="@dimen/itemCardCornerRadius"
    app:cardBackgroundColor="#16192B"
    app:strokeColor="#33F5A623"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_map_entry_card_dark">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/icon_open_map"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_map"
                app:tint="#F5A623"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/text_open_map"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="打开地图"
                android:textColor="#F5A623"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>