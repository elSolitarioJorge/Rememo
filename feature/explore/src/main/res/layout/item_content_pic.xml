<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/itemCardCornerRadius"
        app:cardBackgroundColor="#16192B"
        app:strokeColor="#1AFFFFFF"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_marginBottom="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/img_cover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:src="@drawable/pic_location"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/layout_aiFix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="@id/img_cover"
                app:layout_constraintStart_toStartOf="@id/img_cover"
                android:layout_marginTop="@dimen/labelVertical"
                android:layout_marginStart="@dimen/labelHorizontal"
                android:background="@drawable/bg_ai_fix_dark"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/icon_aiFix"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_brush"
                    app:tint="#F5A623" />

                <TextView
                    android:id="@+id/text_aiFix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="AI修复"
                    android:textColor="#F5A623"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_time_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@id/img_cover"
                app:layout_constraintEnd_toEndOf="@id/img_cover"
                android:layout_marginBottom="@dimen/labelVertical"
                android:layout_marginEnd="@dimen/labelHorizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="1992"
                android:textColor="#F5A623"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_time_label_dark" />

            <TextView
                android:id="@+id/text_post_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/img_cover"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="绿皮车上的离别，和那袋橘子"
                android:textSize="14sp"
                android:textColor="#E2E8F0"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="8dp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_post_avatar"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/pic_my_avatar"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:layout_constraintStart_toStartOf="@id/text_post_title"
                app:layout_constraintTop_toBottomOf="@id/text_post_title"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/text_post_userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="弥巷"
                android:textColor="#F5A623"
                android:textSize="11sp"
                app:layout_constraintStart_toEndOf="@id/img_post_avatar"
                app:layout_constraintTop_toTopOf="@id/img_post_avatar"
                app:layout_constraintBottom_toBottomOf="@id/img_post_avatar"
                android:layout_marginStart="6dp" />

            <ImageView
                android:id="@+id/icon_like"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_gray_like"
                app:tint="#64748B"
                app:layout_constraintTop_toTopOf="@id/text_like_count"
                app:layout_constraintBottom_toBottomOf="@id/text_like_count"
                app:layout_constraintEnd_toStartOf="@id/text_like_count"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/text_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="113.9w"
                android:textColor="#64748B"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="@id/text_post_title"
                app:layout_constraintTop_toTopOf="@id/text_post_userName"
                app:layout_constraintBottom_toBottomOf="@id/text_post_userName" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>