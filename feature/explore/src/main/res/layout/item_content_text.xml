<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="@dimen/itemCardCornerRadius"
        android:elevation="0dp"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_card_yellow"
            >

            <TextView
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="消失的糖葫芦"
                android:textSize="16sp"
                android:textColor="@color/text_brown"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@id/text_like_count"
                android:layout_marginTop="@dimen/textToEdgeVertical"
                android:layout_marginStart="@dimen/textToEdgeHorizontal"
                android:layout_marginEnd="8dp"
                />

            <TextView
                android:id="@+id/text_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="小时候钟楼旁边的那个糖葫芦摊，是我每次考试考100分的专属奖励，小时候钟楼旁边的那个糖葫芦摊，是我每次考试考100分的专属奖励"
                android:textSize="12sp"
                android:textColor="#C89E7F"
                android:fontFamily="serif"
                android:maxLines="4"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"
                app:layout_constraintTop_toBottomOf="@id/text_title"
                app:layout_constraintStart_toStartOf="@id/text_title"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/textToEdgeHorizontal"
                />

            <TextView
                android:id="@+id/text_userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_content_text_card_user_name"
                android:text="\@弥巷"
                android:textSize="14sp"
                android:textColor="@color/text_brown"
                android:textStyle="bold"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/text_content"
                app:layout_constraintStart_toStartOf="@id/text_title"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="@dimen/textToEdgeVertical"
                />

            <TextView
                android:id="@+id/text_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="113.9w"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/text_content"
                app:layout_constraintTop_toTopOf="@id/text_userName"
                app:layout_constraintBottom_toBottomOf="@id/text_userName"
                />

            <ImageView
                android:id="@+id/icon_like"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_gray_like"
                app:layout_constraintTop_toTopOf="@id/text_like_count"
                app:layout_constraintBottom_toBottomOf="@id/text_like_count"
                app:layout_constraintEnd_toStartOf="@id/text_like_count"
                android:layout_marginEnd="2dp"
                android:layout_marginTop="1.5dp"
                />

            <ImageView
                android:id="@+id/like_post_card_double_quotes"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:alpha="0.08"
                android:src="@drawable/ic_double_quotes"
                app:layout_constraintTop_toBottomOf="@id/text_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="12dp"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>