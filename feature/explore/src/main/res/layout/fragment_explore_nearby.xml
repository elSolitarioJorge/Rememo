<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#16192B"
        app:cardCornerRadius="12dp"
        app:strokeColor="#1AFFFFFF"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/icon_current_location"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_current_location"
                android:background="@drawable/bg_current_location_icon"
                app:tint="#3B82F6"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="8dp"
                />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/text_input_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon_current_location"
                app:layout_constraintEnd_toStartOf="@id/icon_refresh"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="12dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editText_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="当前位置：西安市钟楼商圈"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:background="@null"
                    android:padding="0dp"
                    android:gravity="center_vertical" />

            </com.google.android.material.textfield.TextInputLayout>


            <ImageView
                android:id="@+id/icon_refresh"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_refresh"
                app:tint="#F5A623"
                app:layout_constraintTop_toTopOf="@id/icon_current_location"
                app:layout_constraintBottom_toBottomOf="@id/icon_current_location"
                app:layout_constraintEnd_toStartOf="@+id/text_refresh"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/text_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="刷新"
                android:textColor="#F5A623"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/icon_refresh"
                app:layout_constraintBottom_toBottomOf="@id/icon_refresh"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="12dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/explore_nearby_content_recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="8dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layout_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>