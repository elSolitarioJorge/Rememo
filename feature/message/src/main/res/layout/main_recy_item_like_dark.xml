<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#16192B"
    app:strokeColor="#1AFFFFFF"
    app:strokeWidth="1dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/msg_like_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/pic_my_avatar"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp" />

        <ImageView
            android:id="@+id/msg_like_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_type_like"
            app:layout_constraintBottom_toBottomOf="@id/msg_like_avatar"
            app:layout_constraintEnd_toEndOf="@id/msg_like_avatar"
            android:layout_marginBottom="-6dp"
            android:layout_marginEnd="-6dp" />

        <TextView
            android:id="@+id/msg_like_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/msg_like_avatar"
            app:layout_constraintTop_toTopOf="@id/msg_like_avatar"
            android:text="建国叔"
            android:textColor="#E2E8F0"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/msg_like_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/msg_like_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/msg_like_name"
            android:text="16:30"
            android:fontFamily="monospace"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/like_msg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="对这段时光产生了深深的共鸣，点亮了红心"
            android:textColor="#D1D5DB"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/msg_like_name"
            app:layout_constraintTop_toBottomOf="@id/msg_like_name" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/like_post_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/like_msg"
            app:layout_constraintTop_toBottomOf="@id/like_msg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:cardBackgroundColor="#05070A"
            app:strokeColor="#0DFFFFFF"
            app:strokeWidth="1dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <FrameLayout
                    android:id="@+id/quote_icon_box"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="#0AFFFFFF"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <ImageView
                        android:id="@+id/like_post_card_double_quotes"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_double_quotes"
                        app:tint="#64748B" />
                </FrameLayout>

                <TextView
                    android:id="@+id/like_post_card_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="@id/quote_icon_box"
                    app:layout_constraintStart_toEndOf="@id/quote_icon_box"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="12dp"
                    android:text="消失的糖葫芦"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/like_post_card_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/like_post_card_title"
                    app:layout_constraintBottom_toBottomOf="@id/quote_icon_box"
                    app:layout_constraintStart_toStartOf="@id/like_post_card_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="4dp"
                    android:text="小时候钟楼旁边的那个糖葫芦摊，是我..."
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>