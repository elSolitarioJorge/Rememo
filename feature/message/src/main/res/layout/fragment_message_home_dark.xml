<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D17"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/message_main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#E60B0D17"
        android:elevation="0dp"
        app:title="共鸣频段"
        app:titleTextColor="#FFFFFF"
        app:titleMarginStart="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/message_main_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/message_main_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="150dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/message_main_card_like"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#16192B"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/message_main_card_response"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:paddingBottom="14dp">

                    <FrameLayout
                        android:id="@+id/icon_container_like"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_action_like"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_heart_message"
                            app:tint="#EF4444" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/message_likeCard_redDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/bg_badge_dot"
                        app:layout_constraintTop_toTopOf="@id/icon_container_like"
                        app:layout_constraintEnd_toEndOf="@id/icon_container_like"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-2dp" />

                    <TextView
                        android:id="@+id/message_likeCard_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="赞与共鸣"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/icon_container_like"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/message_main_card_response"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#16192B"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="@id/message_main_card_like"
                app:layout_constraintStart_toEndOf="@id/message_main_card_like"
                app:layout_constraintEnd_toStartOf="@id/message_main_card_visitor"
                android:layout_marginStart="12dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:paddingBottom="14dp">

                    <FrameLayout
                        android:id="@+id/icon_container_resp"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_action_comment"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_msg"
                            app:tint="#3B82F6" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/message_respCard_redDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/bg_badge_dot"
                        app:layout_constraintTop_toTopOf="@id/icon_container_resp"
                        app:layout_constraintEnd_toEndOf="@id/icon_container_resp"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-2dp" />

                    <TextView
                        android:id="@+id/message_respCard_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="新回应"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/icon_container_resp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/message_main_card_visitor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#16192B"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="@id/message_main_card_like"
                app:layout_constraintStart_toEndOf="@id/message_main_card_response"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:paddingBottom="14dp">

                    <FrameLayout
                        android:id="@+id/icon_container_vis"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_action_visitor"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_new_visitor"
                            app:tint="#F5A623" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/message_visCard_redDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/bg_badge_dot"
                        app:layout_constraintTop_toTopOf="@id/icon_container_vis"
                        app:layout_constraintEnd_toEndOf="@id/icon_container_vis"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-2dp"/>

                    <TextView
                        android:id="@+id/message_visCard_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="新访客"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/icon_container_vis"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/message_recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/message_main_card_like"
                android:clipToPadding="false" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>