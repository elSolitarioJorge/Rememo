<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/message_main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:elevation="4dp"
        app:title="信箱"
        app:titleTextAppearance="@style/MessageToolbarTitle"
        app:titleMarginStart="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

    </androidx.appcompat.widget.Toolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_gray"
        app:layout_constraintTop_toBottomOf="@id/message_main_toolbar"
        />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/message_main_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 赞与共鸣 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/message_main_card_like"
                android:layout_width="0dp"
                android:layout_height="@dimen/MsgMainCardHeight"
                app:cardCornerRadius="@dimen/MsgMainCardCornerRadius"
                app:cardElevation="@dimen/MsgMainCardElevation"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/message_main_card_response"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"
                android:layout_marginTop="28dp"
                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- 红点提示 -->
                    <ImageView
                        android:id="@+id/message_likeCard_redDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_dot_red"
                        android:visibility="visible"
                        app:layout_constraintTop_toTopOf="@id/message_likeCard_bg"
                        app:layout_constraintEnd_toEndOf="@id/message_likeCard_bg"
                        android:layout_marginEnd="@dimen/MsgMainCardRedDotMargin"
                        />


                    <!-- 图标 -->
                    <ImageView
                        android:id="@+id/message_likeCard_icon"
                        android:layout_width="@dimen/MsgMainCardIconSize"
                        android:layout_height="@dimen/MsgMainCardIconSize"
                        android:src="@drawable/ic_heart"
                        app:layout_constraintTop_toTopOf="@id/message_likeCard_bg"
                        app:layout_constraintStart_toStartOf="@id/message_likeCard_bg"
                        app:layout_constraintEnd_toEndOf="@id/message_likeCard_bg"
                        app:layout_constraintBottom_toBottomOf="@id/message_likeCard_bg"
                        />

                    <!-- 背景 -->
                    <View
                        android:id="@+id/message_likeCard_bg"
                        android:layout_width="@dimen/MsgMainCardViewLength"
                        android:layout_height="@dimen/MsgMainCardViewLength"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_message_bg_circle_red"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />

                    <!-- 文字 -->
                    <TextView
                        android:id="@+id/message_likeCard_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="赞与共鸣"
                        style="@style/MsgCardTextStyle"
                        app:layout_constraintTop_toBottomOf="@id/message_likeCard_bg"
                        app:layout_constraintStart_toStartOf="@id/message_likeCard_bg"
                        app:layout_constraintEnd_toEndOf="@id/message_likeCard_bg"
                        />

                    <!--透明大图标-->
                    <ImageView
                        android:id="@+id/message_likeCard_transparent_icon"
                        android:layout_width="@dimen/MsgMainCardTransparentIconSize"
                        android:layout_height="@dimen/MsgMainCardTransparentIconSize"
                        android:src="@drawable/ic_heart"
                        android:layout_marginEnd="-15dp"
                        android:layout_marginTop="-15dp"
                        android:alpha="0.1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>


            <!-- 新回应 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/message_main_card_response"
                android:layout_width="0dp"
                android:layout_height="@dimen/MsgMainCardHeight"
                app:cardCornerRadius="@dimen/MsgMainCardCornerRadius"
                app:cardElevation="@dimen/MsgMainCardElevation"
                app:layout_constraintTop_toTopOf="@id/message_main_card_like"
                app:layout_constraintStart_toEndOf="@id/message_main_card_like"
                app:layout_constraintEnd_toStartOf="@id/message_main_card_visitor"
                android:layout_marginStart="12dp"
                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- 红点提示 -->
                    <ImageView
                        android:id="@+id/message_respCard_redDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_dot_red"
                        android:visibility="visible"
                        app:layout_constraintTop_toTopOf="@id/message_respCard_bg"
                        app:layout_constraintEnd_toEndOf="@id/message_respCard_bg"
                        android:layout_marginEnd="@dimen/MsgMainCardRedDotMargin"
                        />


                    <!-- 图标 -->
                    <ImageView
                        android:id="@+id/message_respCard_icon"
                        android:layout_width="@dimen/MsgMainCardIconSize"
                        android:layout_height="@dimen/MsgMainCardIconSize"
                        android:src="@drawable/ic_msg"
                        app:layout_constraintTop_toTopOf="@id/message_respCard_bg"
                        app:layout_constraintStart_toStartOf="@id/message_respCard_bg"
                        app:layout_constraintEnd_toEndOf="@id/message_respCard_bg"
                        app:layout_constraintBottom_toBottomOf="@id/message_respCard_bg"
                        />

                    <!-- 背景 -->
                    <View
                        android:id="@+id/message_respCard_bg"
                        android:layout_width="@dimen/MsgMainCardViewLength"
                        android:layout_height="@dimen/MsgMainCardViewLength"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_message_bg_circle_red"
                        android:backgroundTint="#3B82F6"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />

                    <!-- 文字 -->
                    <TextView
                        android:id="@+id/message_respCard_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="新回应"
                        style="@style/MsgCardTextStyle"
                        app:layout_constraintTop_toBottomOf="@id/message_respCard_bg"
                        app:layout_constraintStart_toStartOf="@id/message_respCard_bg"
                        app:layout_constraintEnd_toEndOf="@id/message_respCard_bg"
                        />

                    <!--透明大图标-->
                    <ImageView
                        android:id="@+id/message_respCard_transparent_icon"
                        android:layout_width="@dimen/MsgMainCardTransparentIconSize"
                        android:layout_height="@dimen/MsgMainCardTransparentIconSize"
                        android:src="@drawable/ic_msg"
                        android:layout_marginEnd="-15dp"
                        android:layout_marginTop="-15dp"
                        android:alpha="0.1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>


            <!-- 新增访客 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/message_main_card_visitor"
                android:layout_width="0dp"
                android:layout_height="@dimen/MsgMainCardHeight"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="@dimen/MsgMainCardCornerRadius"
                app:cardElevation="@dimen/MsgMainCardElevation"
                app:layout_constraintTop_toTopOf="@id/message_main_card_response"
                app:layout_constraintStart_toEndOf="@id/message_main_card_response"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="12dp"
                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- 红点提示 -->
                    <ImageView
                        android:id="@+id/message_visCard_redDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_dot_red"
                        android:visibility="visible"
                        app:layout_constraintTop_toTopOf="@id/message_visCard_bg"
                        app:layout_constraintEnd_toEndOf="@id/message_visCard_bg"
                        android:layout_marginEnd="@dimen/MsgMainCardRedDotMargin"
                        />


                    <!-- 图标 -->
                    <ImageView
                        android:id="@+id/message_visCard_icon"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_new_visitor"
                        app:layout_constraintTop_toTopOf="@id/message_visCard_bg"
                        app:layout_constraintStart_toStartOf="@id/message_visCard_bg"
                        app:layout_constraintEnd_toEndOf="@id/message_visCard_bg"
                        app:layout_constraintBottom_toBottomOf="@id/message_visCard_bg"
                        />

                    <!-- 背景 -->
                    <View
                        android:id="@+id/message_visCard_bg"
                        android:layout_width="@dimen/MsgMainCardViewLength"
                        android:layout_height="@dimen/MsgMainCardViewLength"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_message_bg_circle_red"
                        android:backgroundTint="#F59E0B"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />

                    <!-- 文字 -->
                    <TextView
                        android:id="@+id/message_visCard_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="新访客"
                        style="@style/MsgCardTextStyle"
                        app:layout_constraintTop_toBottomOf="@id/message_visCard_bg"
                        app:layout_constraintStart_toStartOf="@id/message_visCard_bg"
                        app:layout_constraintEnd_toEndOf="@id/message_visCard_bg"
                        />

                    <!--透明大图标-->
                    <ImageView
                        android:id="@+id/message_visCard_transparent_icon"
                        android:layout_width="@dimen/MsgMainCardTransparentIconSize"
                        android:layout_height="@dimen/MsgMainCardTransparentIconSize"
                        android:src="@drawable/ic_new_visitor"
                        android:layout_marginEnd="-15dp"
                        android:layout_marginTop="-15dp"
                        android:alpha="0.1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/message_recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/MsgPadding"
                app:layout_constraintTop_toBottomOf="@id/message_main_card_like"
                app:layout_constraintBottom_toBottomOf="parent"
                android:paddingBottom="150dp"
                android:clipToPadding="false"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>