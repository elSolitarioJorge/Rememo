<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#16192B"
    app:strokeColor="#1AFFFFFF"
    app:strokeWidth="1dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/msg_comment_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/pic_my_avatar"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp" />

        <ImageView
            android:id="@+id/msg_comment_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_type_comment"
            app:layout_constraintBottom_toBottomOf="@id/msg_comment_avatar"
            app:layout_constraintEnd_toEndOf="@id/msg_comment_avatar"
            android:layout_marginBottom="-6dp"
            android:layout_marginEnd="-6dp" />

        <TextView
            android:id="@+id/msg_comment_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/msg_comment_avatar"
            app:layout_constraintTop_toTopOf="@id/msg_comment_avatar"
            android:text="老王头"
            android:textColor="#E2E8F0"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/msg_comment_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/msg_comment_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/msg_comment_name"
            android:text="2 HRS AGO"
            android:fontFamily="monospace"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/comment_msg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/msg_comment_name"
            app:layout_constraintStart_toStartOf="@id/msg_comment_name"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="那会儿的橘子是不是特别甜？哈哈哈。这AI上色技术真牛，衣服的颜色都还原对了！"
            android:textSize="13sp"
            android:textColor="#D1D5DB"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/comment_post_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/comment_msg"
            app:layout_constraintTop_toBottomOf="@id/comment_msg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:cardBackgroundColor="#05070A"
            app:strokeColor="#0DFFFFFF"
            app:strokeWidth="1dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">

                <View
                    android:id="@+id/comment_post_card_white_bg"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:rotation="355"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="8dp"
                    />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/comment_post_card_cover"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/pic_avatar2"
                    android:rotation="355"
                    app:shapeAppearanceOverlay="@style/RoundCornerImage"
                    app:layout_constraintTop_toTopOf="@id/comment_post_card_white_bg"
                    app:layout_constraintStart_toStartOf="@id/comment_post_card_white_bg"
                    app:layout_constraintEnd_toEndOf="@id/comment_post_card_white_bg"
                    app:layout_constraintBottom_toBottomOf="@id/comment_post_card_white_bg" />

                <TextView
                    android:id="@+id/comment_post_card_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="@id/comment_post_card_cover"
                    app:layout_constraintStart_toEndOf="@id/comment_post_card_cover"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="10dp"
                    android:text="绿皮车上的离别，和那袋橘子..."
                    android:textColor="#E2E8F0"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/comment_post_card_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/comment_post_card_title"
                    app:layout_constraintBottom_toBottomOf="@id/comment_post_card_cover"
                    app:layout_constraintStart_toStartOf="@id/comment_post_card_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="4dp"
                    android:text="父亲在这里送我，隔着车窗递给我橘子"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>